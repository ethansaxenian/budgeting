package graph

import "github.com/ethansaxenian/budgeting/util"
import "github.com/ethansaxenian/budgeting/components/layout"

script showGraph(title string, datasets []util.GraphData) {
  new Chart(
    document.getElementById('expense-chart'),
    {
      type: 'line',
      data: {
        labels: [...Array(31).keys()].map(i => i + 1),
        datasets: datasets,
      },
      options: {
        plugins: {
          title: {
            display: true,
            text: title,
          },
        }
      }
    }
  );
}

templ Graph(title string, datasets []util.GraphData) {
	@layout.Base() {
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
		<canvas id="expense-chart"></canvas>
		<div>
			@showGraph(title, datasets)
		</div>
	}
}
